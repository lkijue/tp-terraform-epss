# State et données locales Terraform (le state vit dans HCP Terraform)
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variables sensibles ou personnelles : JAMAIS dans Git.
# (les terraform.tfvars versionnés ne contiennent que des valeurs non sensibles)
*.auto.tfvars
*.local.tfvars
secrets.tfvars
*.tfvars.json

# Clés SSH et sorties de scripts
*.pem
id_*
sp-credentials*.json

# Outils
.terraformrc
terraform.rc
.tflint.d/
.vscode/

# Les modules n'ont pas de lock file (seuls les environnements en ont un)
modules/**/.terraform.lock.hcl
