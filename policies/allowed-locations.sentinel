# N'autorise le déploiement que dans les régions validées par l'équipe
# (doivent aussi être autorisées par l'abonnement Azure for Students).
import "tfplan/v2" as tfplan
import "strings"

param allowed_locations default [
	"francecentral",
	"westeurope",
	"northeurope",
	"swedencentral",
	"germanywestcentral",
	"switzerlandnorth",
	"spaincentral",
	"italynorth",
	"polandcentral",
	"norwayeast",
	"uksouth",
	"global",
]

resources = filter tfplan.resource_changes as _, rc {
	rc.mode is "managed" and
	(rc.change.actions contains "create" or rc.change.actions contains "update") and
	keys(rc.change.after) contains "location" and
	rc.change.after.location is not null
}

violations = filter resources as _, rc {
	strings.to_lower(rc.change.after.location) not in allowed_locations
}

for violations as address, rc {
	print("Région interdite :", address, "=", rc.change.after.location)
}

main = rule {
	length(violations) is 0
}
